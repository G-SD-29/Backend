{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"types": ["node"],

		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"strict": true,
		"noUncheckedIndexedAccess": true,

		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"erasableSyntaxOnly": true,

		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src"]
}
